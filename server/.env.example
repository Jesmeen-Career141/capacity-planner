# ===================================================================
# Career141 Capacity Planner - Server Environment Variables Template
# ===================================================================
# Copy this file to .env and replace the placeholder values below.
# DO NOT commit real secrets or credentials to source control.

# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/capacity_planner?retryWrites=true&w=majority

# Frontend Application URL (used for CORS origin configuration)
CLIENT_URL=http://localhost:5174

# Read-only API Token (optional, used for secure external data extraction)
CAPACITY_PLANNER_READ_TOKEN=your_secure_read_token_here

# Cloudflare R2 Storage Credentials (S3-compatible object storage for CV files)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=career141-cv-vault

# Maximum allowed file upload size in bytes (default: 10485760 = 10 MB)
MAX_FILE_SIZE_BYTES=10485760
